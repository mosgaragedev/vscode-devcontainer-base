{
  "compilerOptions": {
    "module": "ES2015",
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["src/views/**/*"],
  "exclude": ["node_modules"]
} 