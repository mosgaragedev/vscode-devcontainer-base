{
  "name": "gitdashboard",
  "displayName": "Git Dashboard",
  "description": "A beautiful Git statistics dashboard for VSCode/Cursor/WindSurf",
  "version": "0.1.9",
  "publisher": "coder-yolo",
  "author": {
    "name": "coder-yolo"
  },
  "repository": {
    "type": "git",
    "private": true,
    "url": "git+https://github.com/JohnChan1996/gitdashboard-feedback.git"
  },
  "engines": {
    "vscode": "^1.70.0",
    "npm": ">=8.0.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "commit",
    "statistics",
    "dashboard",
    "visualization",
    "analytics"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitdashboard.showDashboard",
    "onView:gitDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitdashboard.showDashboard",
        "title": "Show Dashboard"
      }
    ],
    "configuration": [
      {
        "title": "Git Dashboard",
        "properties": {
          "gitDashboard.excludePatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "node_modules/",
              "dist/",
              "build/",
              ".git/",
              ".idea/",
              ".vscode/",
              ".vs/",
              "coverage/",
              "doc/",
              "docs/",
              "test/",
              "tests/",
              "__tests__/",
              "bin/",
              "target/",
              "output/",
              "out/",
              "release/",
              "releases/",
              "package-lock.json",
              "yarn.lock",
              "pnpm-workspace.yaml",
              "pnpm-lock.yaml",
              ".DS_Store",
              ".gitignore",
              ".gitattributes",
              ".gitmodules",
              ".npmrc",
              ".yarnrc",
              ".env",
              ".env.local",
              ".env.development",
              ".env.test",
              ".env.production",
              "LICENSE",
              "README.md",
              "CHANGELOG.md"
            ],
            "description": "List of file matching patterns to exclude, the syntax is similar to .gitignore file.",
            "scope": "window"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "compile:dev": "cross-env NODE_ENV=development webpack",
    "watch": "cross-env NODE_ENV=development webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "vsce:package": "vsce package --baseContentUrl https://github.com/JohnChan1996/gitdashboard-feedback/blob/main --baseImagesUrl https://github.com/JohnChan1996/gitdashboard-feedback/raw/main/resources/imgs"
  },
  "devDependencies": {
    "@types/dom-to-image": "^2.6.7",
    "@types/jspdf": "^1.3.3",
    "@types/minimatch": "^5.1.2",
    "@types/node": "20.x",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/recharts": "^1.8.29",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/vsce": "^3.2.1",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.56.0",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.15",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@types/react-datepicker": "^7.0.0",
    "@types/react-modal": "^3.16.3",
    "@types/react-tabs": "^5.0.4",
    "antd": "^5.23.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dom-to-image-more": "^3.5.0",
    "i18next": "^24.1.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "minimatch": "^10.0.1",
    "react-datepicker": "^7.5.0",
    "react-i18next": "^15.4.0",
    "react-modal": "^3.16.3",
    "react-tabs": "^6.1.0",
    "recharts": "^2.15.1",
    "simple-git": "^3.27.0"
  }
}
