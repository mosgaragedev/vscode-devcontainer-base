<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="vscode-server-connector" Version="0.26.19" Publisher="redhat" />
			<DisplayName>JBoss Toolkit</DisplayName>
			<Description xml:space="preserve">Allows a user to start, stop and deploy to Red Hat server and runtime products like Wildfly and JBoss EAP (Enterprise Application Platform).</Description>
			<Tags>server,runtimes,middleware,adapters,red hat,jboss,wildfly,enterprise application platform,eap</Tags>
			<Categories>Other</Categories>
			<GalleryFlags>Public Preview</GalleryFlags>
			
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.77.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="redhat.vscode-rsp-ui" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="redhat.vscode-rsp-ui" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
				<Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.EnabledApiProposals" Value="" />
				
				<Property Id="Microsoft.VisualStudio.Code.ExecutesCode" Value="true" />
				
				<Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/redhat-developer/vscode-server-connector.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/redhat-developer/vscode-server-connector.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/redhat-developer/vscode-server-connector.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/redhat-developer/vscode-server-connector/issues/" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/redhat-developer/vscode-server-connector#readme" />
				
				
				<Property Id="Microsoft.VisualStudio.Services.GitHubFlavoredMarkdown" Value="true" />
				<Property Id="Microsoft.VisualStudio.Services.Content.Pricing" Value="Free"/>

				
				
			</Properties>
			<License>extension/LICENSE.txt</License>
			<Icon>extension/images/jboss.eap.png</Icon>
		</Metadata>
		<Installation>
			<InstallationTarget Id="Microsoft.VisualStudio.Code"/>
		</Installation>
		<Dependencies/>
		<Assets>
			<Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
			<Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/readme.md" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Content.Changelog" Path="extension/changelog.md" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="extension/LICENSE.txt" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/images/jboss.eap.png" Addressable="true" />
		</Assets>
	</PackageManifest>