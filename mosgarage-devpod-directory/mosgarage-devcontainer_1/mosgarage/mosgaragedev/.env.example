# mosgarage/mosgarage — environment variables
# Copy this to .env and edit as needed

# ── Ports ──────────────────────────────────────────────────────
CODE_SERVER_PORT=8080
NODE_SERVER_PORT=3000
API_PORT=4000

# ── code-server ────────────────────────────────────────────────
CODE_SERVER_PASSWORD=mosgarage   # CHANGE THIS in production

# ── API auth ───────────────────────────────────────────────────
# Leave blank = open access (dev). Set a secret = protected.
API_KEY=

# ── Node ───────────────────────────────────────────────────────
NODE_ENV=production
