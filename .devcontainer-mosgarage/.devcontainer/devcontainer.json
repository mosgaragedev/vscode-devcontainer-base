{
  // ==========================================================================
  // mosgarage — Root Dev Container
  // Works with: Docker CLI in WSL (no Docker Desktop needed)
  // Base: mosgarage/build (your existing image) or ubuntu fallback
  //
  // To open: code . → "Reopen in Container" (VS Code Dev Containers extension)
  // Or CLI:  devcontainer open .
  // ==========================================================================
  "name": "mosgarage-workspace",

  // Pull bootstrap image before build (skips gracefully if offline)
  "initializeCommand": "docker pull mosgarage/codeserver-base:latest || true",

  // Use Docker Compose so all services + databases start together
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",

  // Keep the container running even if you close VS Code
  "shutdownAction": "none",

  // ---------------------------------------------------------------------------
  // VS Code extensions — installed inside the container
  // ---------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        // Language support
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-python.python",
        "ms-python.black-formatter",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Google.google-antigravity"

        // Docker & containers (even inside container — for managing stacks)
        "ms-azuretools.vscode-docker",

        // Database clients
        "ckolkman.vscode-postgres",
        "mongodb.mongodb-vscode",
        "cweijan.vscode-redis-client",

        // API & microservices
        "humao.rest-client",
        "42crunch.vscode-openapi",

        // Git & GitHub
        "github.vscode-pull-request-github",
        "eamodio.gitlens",

        // Quality of life
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens",
        "pkief.material-icon-theme",
        "zhuangtongfa.material-theme"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.fontSize": 14,
        "editor.tabSize": 2,
        "files.autoSave": "onFocusChange",
        // Point editors at the running databases
        "postgresExplorer.connections": [
          {
            "host": "postgres",
            "user": "mosgarage",
            "password": "mosgarage",
            "database": "mosgarage",
            "port": 5432,
            "ssl": false
          }
        ]
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Ports forwarded to your WSL localhost automatically
  // ---------------------------------------------------------------------------
  "forwardPorts": [
    3000,   // api-gateway
    3001,   // auth-service
    3002,   // content-service
    3003,   // learner-service
    3004,   // notification-service
    5432,   // PostgreSQL
    27017,  // MongoDB
    6379,   // Redis
    8080,   // code-server / admin UI
    8081,   // mongo-express
    8082    // redis-commander
  ],

  "portsAttributes": {
    "3000": { "label": "API Gateway",         "onAutoForward": "notify" },
    "3001": { "label": "Auth Service",         "onAutoForward": "silent" },
    "3002": { "label": "Content Service",      "onAutoForward": "silent" },
    "3003": { "label": "Learner Service",      "onAutoForward": "silent" },
    "3004": { "label": "Notification Service", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL",           "onAutoForward": "silent" },
    "27017":{ "label": "MongoDB",              "onAutoForward": "silent" },
    "6379": { "label": "Redis",                "onAutoForward": "silent" },
    "8081": { "label": "Mongo Express",        "onAutoForward": "openBrowser" },
    "8082": { "label": "Redis Commander",      "onAutoForward": "openBrowser" }
  },

  // ---------------------------------------------------------------------------
  // Run once after container is created
  // ---------------------------------------------------------------------------
  "postCreateCommand": "bash /workspace/.devcontainer/scripts/post-create.sh",

  // Run every time container starts
  "postStartCommand": "bash /workspace/.devcontainer/scripts/post-start.sh",

  // Mount your SSH keys so git push works inside the container
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  ],

  "remoteUser": "vscode"
}
