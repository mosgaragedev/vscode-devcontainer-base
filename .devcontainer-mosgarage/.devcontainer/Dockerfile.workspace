# =============================================================================
# Dockerfile.workspace — mosgarage dev workspace
# Built by devcontainer CLI / VS Code directly from WSL Docker socket.
# NO Docker Desktop required.
#
# Tries to use your existing mosgarage/build image as base.
# Falls back to ubuntu:22.04 if not available.
# =============================================================================

# Use your existing build image — change to ubuntu:22.04 if not yet tagged
#FROM ghcr.io/mosgarage/build:latest AS base

# If image not yet pushed, comment above and uncomment:
 FROM ubuntu:22.04 AS base

# ---------------------------------------------------------------------------
# System tools
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core
    curl wget git ca-certificates gnupg lsb-release unzip zip \
    # Shells & editors
    bash zsh nano vim \
    # Build tools
    build-essential make cmake \
    # Network tools (useful for debugging microservices)
    iputils-ping netcat-openbsd dnsutils httpie \
    # DB clients
    postgresql-client \
    # Python
    python3 python3-pip python3-venv python3-dev \
    # jq, yq for config wrangling
    jq \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Node.js 20 LTS (via NodeSource)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g \
        npm@latest \
        typescript \
        ts-node \
        nodemon \
        pnpm \
        @devcontainers/cli \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# .NET 8 SDK
# ---------------------------------------------------------------------------
RUN wget https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python tools
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir \
    fastapi uvicorn \
    sqlalchemy alembic \
    motor pymongo \
    redis \
    pydantic httpx \
    black isort pylint

# ---------------------------------------------------------------------------
# MongoDB shell (mongosh)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
    | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
    && echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] \
    https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" \
    > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y mongodb-mongosh \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Redis CLI
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y redis-tools && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Docker CLI only (NO daemon — uses WSL host socket)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# mosgarage user (matches VS Code devcontainer convention)
# ---------------------------------------------------------------------------
RUN groupadd -g 1000 mosgarage || true \
    && useradd -m -u 1000 -g 1000 -s /bin/bash mosgarage \
    && usermod -aG docker mosgarage \
    && echo "mosgarage ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/mosgarage \
    && chmod 0440 /etc/sudoers.d/mosgarage

# ---------------------------------------------------------------------------
# Shell config for mosgarage user
# ---------------------------------------------------------------------------
USER mosgarage
WORKDIR /home/mosgarage

# Install Oh My Bash for a nicer terminal
RUN bash -c "$(curl -fsSL https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh)" --unattended || true

# Add DB connection aliases so you can just type `pgcli`, `mongocli`, `rcli`
RUN echo '' >> ~/.bashrc \
    && echo '# mosgarage database shortcuts' >> ~/.bashrc \
    && echo 'alias pgcli="psql postgresql://mosgarage:mosgarage@postgres:5432/mosgarage"' >> ~/.bashrc \
    && echo 'alias mongocli="mongosh mongodb://mosgarage:mosgarage@mongodb:27017/mosgarage"' >> ~/.bashrc \
    && echo 'alias rcli="redis-cli -h redis -p 6379 -a mosgarage"' >> ~/.bashrc \
    && echo '' >> ~/.bashrc \
    && echo '# mosgarage service shortcuts' >> ~/.bashrc \
    && echo 'alias mg-logs="docker compose -f /workspace/.devcontainer/docker-compose.yml logs -f"' >> ~/.bashrc \
    && echo 'alias mg-ps="docker compose -f /workspace/.devcontainer/docker-compose.yml ps"' >> ~/.bashrc \
    && echo 'alias mg-up="docker compose -f /workspace/.devcontainer/docker-compose.yml --profile services up -d"' >> ~/.bashrc \
    && echo 'alias mg-down="docker compose -f /workspace/.devcontainer/docker-compose.yml down"' >> ~/.bashrc

WORKDIR /workspace
