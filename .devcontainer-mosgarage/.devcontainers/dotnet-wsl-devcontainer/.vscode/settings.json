{
  // ── .NET / C# ──────────────────────────────────────────────────
  "dotnet.defaultSolution":                   "Mosgarage.sln",
  "omnisharp.enableRoslynAnalyzers":          true,
  "omnisharp.enableEditorConfigSupport":      true,
  "omnisharp.organizeImportsOnFormat":        true,
  "omnisharp.sdkPath":                        "/usr/share/dotnet",
  "csharp.referencesCodeLens.enabled":        true,
  "csharp.testsCodeLens.enabled":             true,
  "csharp.suppressBuildAssetsNotification":   true,

  // ── Editor ────────────────────────────────────────────────────
  "editor.formatOnSave":                      true,
  "editor.formatOnPaste":                     true,
  "editor.inlayHints.enabled":               "on",
  "editor.rulers":                           [120],
  "editor.tabSize":                           4,
  "files.eol":                               "\n",             // LF — critical for WSL2
  "files.trimTrailingWhitespace":             true,
  "files.insertFinalNewline":                 true,

  // ── Per-language formatting ────────────────────────────────────
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize":          4
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize":          2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize":          2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize":          2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.tabSize":          4
  },

  // ── File exclusions (keep explorer clean) ─────────────────────
  "files.exclude": {
    "**/bin":               true,
    "**/obj":               true,
    "**/.git":              true,
    "**/node_modules":      true,
    "**/.vs":               true,
    "**/*.user":            true
  },
  "search.exclude": {
    "**/bin":               true,
    "**/obj":               true,
    "**/node_modules":      true
  },

  // ── Terminal ──────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cwd":                 "/c/Users/igewe",
  "terminal.integrated.shell.windows": "C:\\Program Files\\Git\\bin\\bash.exe",
  "terminal.integrated.env.windows": {
    "HOME": "/c/Users/igewe"
  "terminal.integrated.fontSize":             14,

  // ── Git ───────────────────────────────────────────────────────
  "git.autofetch":                            true,
  "git.confirmSync":                          false,
  "git.enableSmartCommit":                    true,
  "gitlens.codeLens.enabled":                true,

  // ── Docker ────────────────────────────────────────────────────
  "docker.host":                              "unix:///var/run/docker.sock",

  // ── REST Client (test API endpoints in .http files) ───────────
  "rest-client.environmentVariables": {
    "$shared": {},
    "dev": {
      "baseUrl":  "http://localhost:7070",
      "token":    ""
    },
    "prod": {
      "baseUrl":  "https://mosgarage.xyz",
      "token":    ""
    }
  },

  // ── Error Lens ────────────────────────────────────────────────
  "errorLens.enabledDiagnosticLevels":        ["error", "warning"],

  // ── SQLTools ──────────────────────────────────────────────────
  "sqltools.useNodeRuntime":                  true,
  "sqltools.autoOpenSessionFiles": false,
  "php.version": "8.3",
  "intelephense.environment.phpVersion": "8.3"
}
