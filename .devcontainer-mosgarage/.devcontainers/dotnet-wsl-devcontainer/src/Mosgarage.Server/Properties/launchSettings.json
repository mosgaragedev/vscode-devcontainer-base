{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {

    // ── WSL2 — runs the server directly in Ubuntu (no container) ──
    // Visual Studio: right-click project → Debug → Start New Instance
    // Requires: Visual Studio 2022 17.x, "Linux development with C++" workload
    "WSL2": {
      "commandName":            "WSL2",
      "launchBrowser":          true,
      "launchUrl":              "http://localhost:7070/swagger",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT":      "Development",
        "ASPNETCORE_ENVIRONMENT":  "Development",
        "ASPNETCORE_URLS":         "http://+:7070;http://+:7071",
        "MOSGARAGE_ACCESS_URL":    "http://localhost:7070",
        "MOSGARAGE_PG_CONNECTION": "Host=localhost;Port=5432;Database=mosgarage;Username=mosgarage;Password=mosgarage;",
        "MOSGARAGE_SECRET_KEY":    "dev-secret-key-change-in-production-32c",
        "MOSGARAGE_PROVISIONER":   "docker",
        "MOSGARAGE_ENV":           "development",
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
      },
      // dotnet user-secrets set syntax — VS reads this for WSL2 launch
      "dotnetRunMessages":      true,
      "applicationUrl":         "http://localhost:7070"
    },

    // ── Docker (devcontainer) — runs inside the dev container ─────
    // Visual Studio: select "Docker" from the debug dropdown
    // Requires Docker Desktop with WSL2 backend
    "Docker": {
      "commandName":            "Docker",
      "launchBrowser":          true,
      "launchUrl":              "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "publishAllPorts":        true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT":      "Development",
        "ASPNETCORE_ENVIRONMENT":  "Development",
        "ASPNETCORE_URLS":         "http://+:7070;http://+:7071",
        "MOSGARAGE_ACCESS_URL":    "http://localhost:7070",
        "MOSGARAGE_PG_CONNECTION": "Host=database;Port=5432;Database=mosgarage;Username=mosgarage;Password=mosgarage;",
        "MOSGARAGE_SECRET_KEY":    "dev-secret-key-change-in-production-32c",
        "MOSGARAGE_PROVISIONER":   "docker",
        "MOSGARAGE_ENV":           "development"
      },
      "httpPort":               7070,
      "useSSL":                 false,
      "sslPort":                0
    },

    // ── Docker Compose — uses the devcontainer compose overlay ────
    // Visual Studio: select "Docker Compose" from the debug dropdown
    "Docker Compose": {
      "commandName":            "DockerCompose",
      "launchBrowser":          true,
      "launchUrl":              "http://localhost:7070/swagger",
      "dockerComposeProfiles":  [],
      "environmentVariables": {
        "DOTNET_ENVIRONMENT":      "Development",
        "ASPNETCORE_ENVIRONMENT":  "Development"
      }
    },

    // ── http (plain dotnet run from inside WSL/container) ─────────
    "http": {
      "commandName":            "Project",
      "dotnetRunMessages":      true,
      "launchBrowser":          true,
      "launchUrl":              "http://localhost:7070/swagger",
      "applicationUrl":         "http://localhost:7070;http://localhost:7071",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT":      "Development",
        "ASPNETCORE_ENVIRONMENT":  "Development",
        "MOSGARAGE_ACCESS_URL":    "http://localhost:7070",
        "MOSGARAGE_PG_CONNECTION": "Host=localhost;Port=5432;Database=mosgarage;Username=mosgarage;Password=mosgarage;",
        "MOSGARAGE_SECRET_KEY":    "dev-secret-key-change-in-production-32c",
        "MOSGARAGE_PROVISIONER":   "docker",
        "MOSGARAGE_ENV":           "development"
      }
    }
  }
}
