{
  "daemon": {
    "port": 4747,
    "host": "127.0.0.1",
    "name": "mosgaraged",
    "pidFile": ".mosgaraged.pid",
    "logLevel": "info",
    "logDir": "./logs"
  },
  "healthcheck": {
    "enabled": true,
    "intervalSeconds": 30,
    "timeoutSeconds": 5,
    "unhealthyThreshold": 3
  },
  "docker": {
    "enabled": true,
    "socketPath": "/var/run/docker.sock",
    "windowsNamedPipe": "//./pipe/docker_engine",
    "autoManage": true
  },
  "workspaceapps": {
    "definitionsDir": "./workspaceapps/definitions",
    "autoStartOnBoot": true,
    "restartPolicy": "on-failure",
    "maxRestarts": 5,
    "restartDelayMs": 3000
  },
  "api": {
    "cors": true,
    "allowedOrigins": ["http://localhost:*", "http://127.0.0.1:*"],
    "auth": {
      "enabled": false,
      "token": ""
    }
  }
}
