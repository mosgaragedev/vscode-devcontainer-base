#!/usr/bin/env node
'use strict';

/**
 * mosgaraged CLI
 * Usage: mgd <command> [options]
 */

const { program } = require('commander');
const fetch = require('node-fetch');
const fs = require('fs');
const path = require('path');

const PKG = require('../package.json');
const CONFIG_FILE = path.resolve(process.cwd(), 'mosgaraged.config.json');

function loadPort() {
  try {
    const cfg = JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
    return cfg.daemon?.port || 4747;
  } catch {
    return 4747;
  }
}

const PORT = loadPort();
const BASE = `http://127.0.0.1:${PORT}/api/v1`;

async function api(method, path_, body) {
  try {
    const res = await fetch(`${BASE}${path_}`, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  } catch {
    console.error(`\x1b[31m✗ Cannot reach mosgaraged at ${BASE}\x1b[0m`);
    console.error('  Is it running? Try: node src/daemon.js');
    process.exit(1);
  }
}

function table(rows) {
  if (!rows.length) { console.log('  (none)'); return; }
  const cols = Object.keys(rows[0]);
  const widths = cols.map(c => Math.max(c.length, ...rows.map(r => String(r[c] ?? '').length)));
  const header = cols.map((c, i) => c.toUpperCase().padEnd(widths[i])).join('  ');
  const sep = widths.map(w => '─'.repeat(w)).join('──');
  console.log(`\n  ${header}\n  ${sep}`);
  for (const row of rows) {
    const line = cols.map((c, i) => {
      const val = String(row[c] ?? '');
      const colored = stateColor(c, val);
      return colored.padEnd(widths[i] + (colored.length - val.length));
    }).join('  ');
    console.log(`  ${line}`);
  }
  console.log();
}

function stateColor(col, val) {
  if (col !== 'state') return val;
  const colors = { running: '\x1b[32m', stopped: '\x1b[33m', error: '\x1b[31m', unhealthy: '\x1b[35m', starting: '\x1b[36m', restarting: '\x1b[36m' };
  return `${colors[val] || ''}${val}\x1b[0m`;
}

// ── Commands ──────────────────────────────────────────────────────────────

program
  .name('mgd')
  .description('MosGarage Daemon CLI')
  .version(PKG.version);

program
  .command('status')
  .description('Show daemon status')
  .action(async () => {
    const d = await api('GET', '/status');
    console.log('\n\x1b[1mmosgaraged status\x1b[0m');
    console.log(`  Name     : ${d.daemon?.name}`);
    console.log(`  Version  : ${d.daemon?.version}`);
    console.log(`  PID      : ${d.daemon?.pid}`);
    console.log(`  Uptime   : ${Math.floor(d.uptime)}s`);
    console.log(`  Platform : ${d.platform}`);
    console.log(`  Node     : ${d.nodeVersion}`);
    const mem = d.memory;
    console.log(`  Memory   : ${Math.round(mem?.rss / 1024 / 1024)}MB RSS\n`);
  });

program
  .command('list')
  .alias('ls')
  .description('List all workspace apps')
  .action(async () => {
    const d = await api('GET', '/apps');
    console.log('\n\x1b[1mWorkspace Apps\x1b[0m');
    table(d.apps.map(a => ({
      id: a.id,
      name: a.name,
      type: a.type,
      state: a.state,
      restarts: a.restartCount,
      'started at': a.startedAt ? new Date(a.startedAt).toLocaleTimeString() : '-',
    })));
  });

program
  .command('start <id>')
  .description('Start a workspace app')
  .action(async (id) => {
    console.log(`Starting ${id}...`);
    const d = await api('POST', `/apps/${id}/start`);
    if (d.ok) console.log(`\x1b[32m✓ ${id} started (state: ${d.app?.state})\x1b[0m`);
    else console.error(`\x1b[31m✗ ${d.error}\x1b[0m`);
  });

program
  .command('stop <id>')
  .description('Stop a workspace app')
  .action(async (id) => {
    console.log(`Stopping ${id}...`);
    const d = await api('POST', `/apps/${id}/stop`);
    if (d.ok) console.log(`\x1b[32m✓ ${id} stopped\x1b[0m`);
    else console.error(`\x1b[31m✗ ${d.error}\x1b[0m`);
  });

program
  .command('restart <id>')
  .description('Restart a workspace app')
  .action(async (id) => {
    console.log(`Restarting ${id}...`);
    const d = await api('POST', `/apps/${id}/restart`);
    if (d.ok) console.log(`\x1b[32m✓ ${id} restarted (state: ${d.app?.state})\x1b[0m`);
    else console.error(`\x1b[31m✗ ${d.error}\x1b[0m`);
  });

program
  .command('health <id>')
  .description('Check health of a workspace app')
  .action(async (id) => {
    const d = await api('GET', `/apps/${id}/health`);
    if (d.ok) {
      const icon = d.healthy ? '\x1b[32m✓ healthy\x1b[0m' : '\x1b[31m✗ unhealthy\x1b[0m';
      console.log(`${id}: ${icon}`);
    } else {
      console.error(`\x1b[31m✗ ${d.error}\x1b[0m`);
    }
  });

program.parse();
