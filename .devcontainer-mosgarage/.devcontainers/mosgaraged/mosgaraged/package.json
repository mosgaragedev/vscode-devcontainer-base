{
  "name": "mosgaraged",
  "version": "1.0.0",
  "description": "MosGarage Workspace Daemon — cross-platform workspace application orchestrator",
  "main": "src/daemon.js",
  "bin": {
    "mosgaraged": "./bin/mosgaraged",
    "mgd": "./bin/mosgaraged"
  },
  "scripts": {
    "start": "node src/daemon.js",
    "dev": "node --watch src/daemon.js",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js",
    "status": "node bin/mosgaraged status",
    "stop": "node bin/mosgaraged stop"
  },
  "keywords": ["mosgarage", "workspace", "daemon", "devops", "orchestrator"],
  "author": "mosgarage",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "dockerode": "^4.0.2",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "node-fetch": "^2.7.0",
    "pidusage": "^3.0.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.4.1",
    "commander": "^12.0.0",
    "systeminformation": "^5.22.6",
    "node-cron": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
