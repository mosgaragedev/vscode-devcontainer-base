{
  "id": "dev-server",
  "name": "Dev Server",
  "type": "process",
  "autoStart": false,
  "command": "node",
  "args": ["server.js"],
  "cwd": "./apps/dev-server",
  "env": {
    "NODE_ENV": "development",
    "PORT": "3000"
  },
  "ports": ["3000:3000"],
  "restartPolicy": "on-failure",
  "maxRestarts": 3,
  "healthcheck": {
    "type": "http",
    "port": 3000,
    "path": "/health",
    "expectedStatus": 200,
    "timeoutMs": 5000
  },
  "tags": ["web", "node"]
}
